{
    "name": "joshdaugherty/home-dashboard",
    "description": "A responsive, touch-first family dashboard kiosk (Livewire + Flux) for a wall-mounted photo frame.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "flux", "dashboard", "kiosk"],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "livewire/livewire": "^4.1",
        "livewire/flux": "^2.13.1"
    },
    "autoload": {
        "psr-4": {
            "JoshDaugherty\\HomeDashboard\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JoshDaugherty\\HomeDashboard\\HomeDashboardServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
