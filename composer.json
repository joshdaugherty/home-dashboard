{
    "name": "joshdaugherty/home-dashboard",
    "description": "A responsive, touch-first family dashboard kiosk (Livewire + Flux) for a wall-mounted photo frame.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "flux", "dashboard", "kiosk", "calendar", "ical", "weather"],
    "homepage": "https://github.com/joshdaugherty/home-dashboard",
    "authors": [
        {
            "name": "Josh Daugherty",
            "email": "15675878+joshdaugherty@users.noreply.github.com",
            "homepage": "https://github.com/joshdaugherty"
        }
    ],
    "support": {
        "issues": "https://github.com/joshdaugherty/home-dashboard/issues",
        "source": "https://github.com/joshdaugherty/home-dashboard"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "livewire/livewire": "^4.1",
        "livewire/flux": "^2.13.1",
        "sabre/vobject": "^4.5"
    },
    "autoload": {
        "psr-4": {
            "JoshDaugherty\\HomeDashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JoshDaugherty\\HomeDashboard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JoshDaugherty\\HomeDashboard\\HomeDashboardServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^11.0"
    }
}
